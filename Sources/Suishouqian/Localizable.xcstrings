          }
        }
      }
    },
    "随手迁不代改别人的启动配置：可在登录项设置里关闭，或在 Finder 里自行处理": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suishouqian won’t edit another app’s login item. Turn it off in Login Items, or deal with it in Finder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随手迁不代改别人的启动配置：可在登录项设置里关闭，或在 Finder 里自行处理"
          }
        }
      }
    },
    "Spotlight 正在索引外置盘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight is indexing the external drive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Spotlight 正在索引外置盘"
          }
        }
      }
    },
    "复制关闭命令": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy the command to turn it off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制关闭命令"
          }
        }
      }
    },
    "搜索应用名时外置盘副本会和内置入口一起出现（两个结果点哪个看运气），后台持续扫描也白耗盘和电。关掉这块盘的索引是外置 SSD 的标准养护；代价是盘上的东西不再出现在 Spotlight 搜索里。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for an app name lists the external copy next to the one in Applications, and you can’t tell which is which. Indexing also wears the drive and uses power. Turning indexing off is normal care for an external SSD. The tradeoff is that files on the drive no longer appear in Spotlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索应用名时外置盘副本会和内置入口一起出现（两个结果点哪个看运气），后台持续扫描也白耗盘和电。关掉这块盘的索引是外置 SSD 的标准养护；代价是盘上的东西不再出现在 Spotlight 搜索里。"
          }
        }
      }
    },
    "关闭这块盘的索引（需管理员授权）": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Off Indexing for This Drive (administrator password required)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭这块盘的索引（需管理员授权）"
          }
        }
      }
    },
    "Spotlight 索引已关闭": {
      "extractionState": "manual",
      "localizations": {
