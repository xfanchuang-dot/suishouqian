    "%@%@ 正在外置盘上运行，强制使用可能异常，建议尽快保存并退出": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ is running from the external drive. Force-quitting may lose work — save and quit"
          }
