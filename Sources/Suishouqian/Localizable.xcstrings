    "Ollama 模型": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama models"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 模型"
          }
        }
      }
    },
    "终端执行：launchctl setenv OLLAMA_MODELS /Volumes/<外置盘>/OllamaModels ，然后重启 ollama（菜单栏骆驼图标→Quit）再拉模型即可。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Terminal, run launchctl setenv OLLAMA_MODELS /Volumes/<drive>/OllamaModels, then quit Ollama from the menu-bar llama and start it again before pulling models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端执行：launchctl setenv OLLAMA_MODELS /Volumes/<外置盘>/OllamaModels ，然后重启 ollama（菜单栏骆驼图标→Quit）再拉模型即可。"
          }
        }
      }
    },
    "iPhone 备份": {
      "extractionState": "manual",
