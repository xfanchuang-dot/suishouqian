    "其中 %lld 个是 App Store 应用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of them are App Store apps"
          }
        },
        "zh-Hans": {
