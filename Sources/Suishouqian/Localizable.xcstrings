        }
      }
    },
    "上次打开 %lld 天前 · %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last opened %lld days ago · %@"
          }
        },
        "zh-Hans": {
