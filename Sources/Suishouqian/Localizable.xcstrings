      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In LM Studio, open the right sidebar → My Models, and point the model folder at the external drive. Point existing models at the new folder inside the app. Let the app manage files this large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio → 右侧边栏设置 → My Models，把模型目录指到外置盘文件夹，已有模型可在应用里重新指向。模型文件几十 GB，让应用自己管理最稳。"
          }
