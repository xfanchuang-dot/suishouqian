      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough space for %@. About %@ is required because the backup drive is offline and the backup would fall back to this disk. %@ is free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标盘空间不足：%@ 的应用需要约 %@（备份盘离线，回退同盘需留备份空间），仅剩 %@"
          }
        }
      }
    },
