      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the destination volume’s UUID, so its identity isn’t confirmed. The move was blocked."
          }
        },
        "zh-Hans": {
