    "开启前请先授予完全磁盘访问权限": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant Full Disk Access before turning this on"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启前请先授予完全磁盘访问权限"
          }
        }
      }
    },
    "请在 系统设置 → 隐私与安全性 → 完全磁盘访问权限 中勾选「随手迁」，否则桌面/文稿/下载扫描不到内容，且可能反复弹授权框。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Full Disk Access, turn on Suishouqian. Otherwise Desktop, Documents, and Downloads can’t be scanned, and macOS may keep asking for permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 系统设置 → 隐私与安全性 → 完全磁盘访问权限 中勾选「随手迁」，否则桌面/文稿/下载扫描不到内容，且可能反复弹授权框。"
          }
        }
      }
    },
    "仍要开启": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn On Anyway"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍要开启"
          }
        }
      }
    },
    "迁移前备份保留": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep backups after a move"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移前备份保留"
          }
        }
      }
    },
    "每次迁移在外置盘 .suishouqian-backup 留底，超期后下次扫描自动清理；回迁成功即回收": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each move keeps a copy in .suishouqian-backup on the external drive. After the retention period, the next scan cleans it up. A successful move back deletes it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次迁移在外置盘 .suishouqian-backup 留底，超期后下次扫描自动清理；回迁成功即回收"
          }
        }
      }
    },
