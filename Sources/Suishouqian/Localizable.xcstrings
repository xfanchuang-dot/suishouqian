            "value": "Keep the external copy (rename the local one)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以外置盘为准（本地改名隔离）"
          }
        }
      }
    },
    "处置会把本地重建的目录改名为「××（离线重建 日期）」留在原地，链接恢复指向外置盘；两边的合并请自行确认后手动处理，工具不做自动合并。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This renames the folder the app recreated locally to “name (recreated offline, date)” and leaves it there. The link points at the external copy again. Merging the two is up to you — this app won’t merge them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处置会把本地重建的目录改名为「××（离线重建 日期）」留在原地，链接恢复指向外置盘；两边的合并请自行确认后手动处理，工具不做自动合并。"
          }
        }
      }
    },
    "没有发现可处理的数据目录": {
