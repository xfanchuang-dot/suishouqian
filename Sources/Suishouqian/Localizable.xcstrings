{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "迁移完成": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "迁移完成"
          }
        }
      }
    },
    "「%@」已迁移到外置硬盘，节省 %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is now on an external drive. Freed %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」已迁移到外置硬盘，节省 %@"
          }
        }
      }
    },
    "自动恢复 %lld 个：%@%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically moved %lld back: %@%@"
