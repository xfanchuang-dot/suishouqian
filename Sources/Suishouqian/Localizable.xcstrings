            "value": "That path isn’t a mounted external drive (the volume name may have changed). The move was blocked so nothing is written to the internal drive."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标路径不是已挂载的外置硬盘（卷名可能已变更），已阻止迁移以免数据写入内置盘"
          }
        }
      }
    },
