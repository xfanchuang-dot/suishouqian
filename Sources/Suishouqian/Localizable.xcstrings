          }
        }
      }
    },
    "超过 %lld 天没打开，占着盘面却想不起来用": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not opened in %lld days, but it’s still taking space"
          }
        },
