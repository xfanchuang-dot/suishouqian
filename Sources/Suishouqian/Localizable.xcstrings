            "value": "Move Back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搬回内置盘"
          }
        }
      }
    },
    "搬回后应用就在内置盘本地，不再依赖外置盘": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After this, the app lives on the internal drive and no longer needs the external drive."
          }
        },
